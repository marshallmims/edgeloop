{
  "name": "edgeloop",
  "version": "1.1.5.15",
  "description": "Autonomous biofeedback edging system: links a Bluetooth heart-rate monitor to The Handy, Intiface/Buttplug.io toys and TCode strokers.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "test": "node --test \"src/js/**/*.test.js\" \"desktop/**/*.test.js\" app/host.test.mjs",
    "desktop": "node desktop/host.mjs",
    "smoke": "node tools/smoke.js",
    "start": "python3 -m http.server 8000",
    "app": "node app/host.mjs",
    "deploy:dev": "npx wrangler deploy --env dev"
  }
}
